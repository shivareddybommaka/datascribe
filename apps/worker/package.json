{
  "name": "@datascribe/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup src/index.ts --format esm --target node22 --out-dir dist --clean",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@datascribe/billing": "workspace:*",
    "@datascribe/db": "workspace:*",
    "@datascribe/medical-data": "workspace:*",
    "@datascribe/shared": "workspace:*",
    "bullmq": "^5.52.0",
    "nodemailer": "^10.2.1",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.17",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4"
  }
}
