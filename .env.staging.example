# Local staging on the Mac Studio (docs/STAGING.md, D-120..D-124). Copy to .env.staging (git-ignored)
# and fill the empty secrets. Synthetic data only. Never put the Cloudflare tunnel token here.
#
# NODE_ENV=production and DEPLOY_ENV=staging are set by scripts/staging.mjs; staging refuses a real
# LLM, Textract, live Stripe keys, SMTP other than Mailpit, Postgres 5432, databases not named
# *staging*, and an http APP_URL.

# Public URL (Cloudflare tunnel → http://localhost:3020). https only.
APP_URL=https://datascribe.stayspot.app
# Web app port: 3020 only (never 3000 = StaySpot CRM, never 3010 = dev preview). Bound to 127.0.0.1.
WEB_PORT=3020
API_PORT=4020
API_URL=http://127.0.0.1:4020

# Datascribe's Docker Postgres on 5433, staging's own databases (5432 is another system: never).
DATABASE_URL=postgresql://datascribe:datascribe@localhost:5433/datascribe_staging
# Payload CMS database, only if you run the CMS (staging doesn't: see CMS_URL)
CMS_DATABASE_URL=postgresql://datascribe:datascribe@localhost:5433/datascribe_staging_cms
# none = render the bundled marketing copy, no CMS process (its media URLs would be localhost-only)
CMS_URL=none

# Redis DB 5 with its own key and queue prefixes (dev uses other DBs/prefixes)
REDIS_URL=redis://localhost:6379/5
REDIS_KEY_PREFIX=ds-staging:
QUEUE_PREFIX=staging
DISPATCH_INTERVAL_MS=2000
PIPELINE_START_CASES=true

# Generate each: openssl rand -base64 48 (JWT) / openssl rand -base64 32 (PHI). Staging-only values,
# not dev's and never production's.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PHI_ENCRYPTION_KEY=
# Password of every seeded synthetic user (12+ characters); staging-only
SEED_USER_PASSWORD=

# Local SeaweedFS (docker compose, 127.0.0.1:9000) with staging's own buckets. No SSE locally.
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET_DOCUMENTS=ds-staging-documents
S3_BUCKET_DELIVERABLES=ds-staging-deliverables
# same values as docker compose's SeaweedFS (S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY in .env)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SSE=none
# Browsers behind the tunnel can't reach localhost:9000: the API relays uploads/downloads (D-122)
S3_BROWSER_ACCESS=relay
# Keep parts ≤ 9 MiB: Next's rewrite proxy passes at most 10 MB of a request body
UPLOAD_PART_SIZE_MB=8
INVOICE_STORAGE_DIR=.data/staging/invoices

# Virus scan: empty = mock scanner (EICAR only). For ClamAV: docker compose --profile scan up -d,
# then CLAMAV_HOST=localhost
CLAMAV_HOST=
CLAMAV_PORT=3310

# Behind cloudflared (127.0.0.1) → Next → API: trust the loopback hop only, and take the client IP
# from CF-Connecting-IP (D-121)
TRUST_PROXY=loopback
TRUST_CF_CONNECTING_IP=true
RATE_LIMIT_AUTH=30
RATE_LIMIT_PUBLIC=10
RATE_LIMIT_ACCOUNT=10
AUTH_RESPONSE_FLOOR_MS=400

# Mailpit only (http://localhost:8025): staging refuses any other SMTP host
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@datascribe.example
SALES_INBOX=sales@datascribe.example
STAFF_EMAIL_DOMAINS=

# Fake gateway (simulated checkout). A Stripe *test* key also works; live keys are refused.
PAYMENT_GATEWAY=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: FAKE_GATEWAY_SECRET=<16+ characters> signs the simulated checkout (a default otherwise)

# No real third parties: mock medical data, local OCR, mock summarizer (anything else is refused)
MEDICAL_DATA_PROVIDER=mock
OCR_PROVIDER=tesseract
SUMMARY_PROVIDER=mock
PHI_LLM_BAA_CONFIRMED=false

# Analytics never load in staging, whatever is set here
GA4_MEASUREMENT_ID=
GTM_ID=
SENTRY_DSN=
LOG_LEVEL=info
