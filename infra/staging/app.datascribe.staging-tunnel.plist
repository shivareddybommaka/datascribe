<?xml version="1.0" encoding="UTF-8"?>
<!--
  TEMPLATE, not installed (docs/STAGING.md "Run at login"). Runs Datascribe's own staging tunnel
  for account nova, separate from StaySpot's, with exactly the command `pnpm staging:tunnel` uses:
  its own config file (always passed, so cloudflared never reads ~/.cloudflared) and the token
  from the git-ignored .env.tunnel-token that Shiva writes. Replace __REPO__ with the checkout
  path before copying it to ~/Library/LaunchAgents.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>app.datascribe.staging-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/cloudflared</string>
    <string>tunnel</string>
    <string>--config</string>
    <string>infra/staging/cloudflared.yml</string>
    <string>run</string>
    <string>--token-file</string>
    <string>.env.tunnel-token</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/Users/nova/Library/Logs/datascribe-staging-tunnel.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/nova/Library/Logs/datascribe-staging-tunnel.log</string>
</dict>
</plist>
