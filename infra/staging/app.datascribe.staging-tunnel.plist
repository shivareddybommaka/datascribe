<?xml version="1.0" encoding="UTF-8"?>
<!--
  TEMPLATE, not installed (docs/STAGING.md "Run at login"). Runs Datascribe's own staging tunnel
  for account nova, separate from StaySpot's: its own token, its own config file (never
  ~/.cloudflared). The token is read from the login Keychain (service datascribe-staging-tunnel),
  never stored in this file or the repo. Replace __REPO__ with the checkout path before copying it
  to ~/Library/LaunchAgents.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>app.datascribe.staging-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>export TUNNEL_TOKEN="$(/usr/bin/security find-generic-password -a nova -s datascribe-staging-tunnel -w)" &amp;&amp; exec /opt/homebrew/bin/cloudflared --config __REPO__/infra/staging/cloudflared.yml tunnel run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/Users/nova/Library/Logs/datascribe-staging-tunnel.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/nova/Library/Logs/datascribe-staging-tunnel.log</string>
</dict>
</plist>
