# Copy to staging.tfvars (git-ignored) and replace every <placeholder>. No secrets here, ever:
# secrets go in Secrets Manager (docs/INFRA.md).

environment    = "staging"
aws_account_id = "<12-digit staging account id>"
region         = "ap-south-1"

vpc_cidr           = "10.40.0.0/16"
az_count           = 2
single_nat_gateway = true

app_domain          = "<staging.app.example.com>"
acm_certificate_arn = "arn:aws:acm:ap-south-1:<account id>:certificate/<certificate id>"

db_instance_class        = "db.t4g.small"
db_allocated_storage_gb  = 20
db_multi_az              = false
db_backup_retention_days = 30
deletion_protection      = false

redis_node_type = "cache.t4g.micro"
redis_replicas  = 0

bucket_prefix = "<company>-datascribe-staging"

image_api    = "<account id>.dkr.ecr.ap-south-1.amazonaws.com/datascribe-staging/api@sha256:<64 hex digest>"
image_web    = "<account id>.dkr.ecr.ap-south-1.amazonaws.com/datascribe-staging/web@sha256:<64 hex digest>"
image_worker = "<account id>.dkr.ecr.ap-south-1.amazonaws.com/datascribe-staging/worker@sha256:<64 hex digest>"

# 0 on the first apply, until every secret has a value; then 1.
api_desired_count    = 0
web_desired_count    = 0
worker_desired_count = 0

log_retention_days = 90

mail_from           = "no-reply@<staging domain>"
smtp_host           = "email-smtp.ap-south-1.amazonaws.com"
smtp_port           = 587
staff_email_domains = "<staff email domain>"

medical_data_provider = "mock"
ocr_provider          = "tesseract"
summary_provider      = "mock"
phi_llm_baa_confirmed = false
optional_secrets      = []
