NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
DATABASE_URL=postgresql://datascribe:datascribe@localhost:5432/datascribe
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# 32-byte base64, or use KMS in production. Generate: openssl rand -base64 32
PHI_ENCRYPTION_KEY=
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET_DOCUMENTS=ds-documents
S3_BUCKET_DELIVERABLES=ds-deliverables
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@datascribe.example
# test mode key only in dev
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_GATEWAY=stripe
# nlm | mock
MEDICAL_DATA_PROVIDER=mock
# optional
OPENFDA_API_KEY=
# optional, later
NLM_UTS_API_KEY=
# tesseract | textract | mock
OCR_PROVIDER=tesseract
# mock | anthropic | openai
SUMMARY_PROVIDER=mock
LLM_API_KEY=
PHI_LLM_BAA_CONFIRMED=false
SENTRY_DSN=
GA4_MEASUREMENT_ID=
GTM_ID=
PAYLOAD_SECRET=
