NODE_ENV=development
# local | staging | production. Unset = production when NODE_ENV=production, local otherwise (D-120).
# Staging (a production build on the Mac, synthetic data): see .env.staging.example and docs/STAGING.md
DEPLOY_ENV=
APP_URL=http://localhost:3010
API_URL=http://localhost:4000
API_PORT=4000
# Interface the API listens on; empty = all interfaces. Staging uses 127.0.0.1.
API_HOST=
# Dev only: extra browser origins trusted for CORS/CSRF, comma-separated (e.g. a preview proxy)
EXTRA_TRUSTED_ORIGINS=
# Datascribe's Docker Postgres is on 5433. Port 5432 on this Mac is a different (existing) system: never use it.
DATABASE_URL=postgresql://datascribe:datascribe@localhost:5433/datascribe
POSTGRES_PORT=5433
REDIS_URL=redis://localhost:6379
# Prefix for the shared rate-limit / usage-stat keys in Redis (D-111, D-112)
REDIS_KEY_PREFIX=ds:
# Worker: BullMQ key prefix (own key space per checkout on a shared Redis), how often it hands
# completed uploads and submitted cases to the queues, and whether it starts the pipeline (D-081)
QUEUE_PREFIX=bull
DISPATCH_INTERVAL_MS=2000
PIPELINE_START_CASES=true
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# 32-byte base64, or use KMS in production. Generate: openssl rand -base64 32
PHI_ENCRYPTION_KEY=
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET_DOCUMENTS=ds-documents
S3_BUCKET_DELIVERABLES=ds-deliverables
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Server-side encryption for uploaded records: AES256 | aws:kms | none.
# Local SeaweedFS can't do SSE without a KMS, so use none locally (D-070). Production refuses none.
S3_SSE=AES256
# Only with S3_SSE=aws:kms (optional; the bucket's default key otherwise)
S3_SSE_KMS_KEY_ID=
# Multipart upload part size in MiB (minimum 5)
UPLOAD_PART_SIZE_MB=8
# ClamAV (clamd) for upload virus scans (run by the worker): docker compose --profile scan up -d, then CLAMAV_HOST=localhost.
# Unset = mock scanner (detects only the EICAR test file). Required in production.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Per-IP limits per 15 minutes: sign-in/MFA/refresh, and register/forgot/invite accept
RATE_LIMIT_AUTH=30
RATE_LIMIT_PUBLIC=10
# Per-account limit per 15 minutes on sign-in/MFA/forgot/register, whatever the IP
RATE_LIMIT_ACCOUNT=10
# Which proxy hops may set X-Forwarded-For: loopback (local Next proxy), a hop count, or CIDRs.
# Never "true": clients could then pick their own IP and dodge the per-IP limits.
TRUST_PROXY=loopback
# Minimum response time (ms) of sign-in / register / forgot, so timing doesn't reveal accounts
AUTH_RESPONSE_FLOOR_MS=400
# Datascribe's own email domains, never allowed as a converted client's admin (default: MAIL_FROM's)
STAFF_EMAIL_DOMAINS=
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@datascribe.example
SALES_INBOX=sales@datascribe.example
# test mode key only in dev
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_GATEWAY=stripe
# nlm | mock
MEDICAL_DATA_PROVIDER=mock
# optional in dev; register a free key before production (D-052)
OPENFDA_API_KEY=
# true runs the optional live medical API smoke tests (synthetic terms only); never in CI
RUN_LIVE_API_TESTS=false
# optional, later
NLM_UTS_API_KEY=
# tesseract | textract | mock
OCR_PROVIDER=tesseract
# mock | anthropic | openai
SUMMARY_PROVIDER=mock
LLM_API_KEY=
PHI_LLM_BAA_CONFIRMED=false
SENTRY_DSN=
# Marketing analytics: loaded only on public pages after cookie consent. Empty = not loaded.
GA4_MEASUREMENT_ID=
GTM_ID=
# Payload CMS (apps/cms). Its own database, separate from the platform DB (D-030).
CMS_PORT=3001
CMS_URL=http://localhost:3001
CMS_DATABASE_URL=postgresql://datascribe:datascribe@localhost:5433/datascribe_cms
# Generate: openssl rand -hex 32
PAYLOAD_SECRET=
# Dev/test only: password given to every seeded user. Never set in production.
SEED_USER_PASSWORD=
