{
  "name": "datascribe",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "load": "pnpm --filter @datascribe/api load",
    "format": "prettier --write . --log-level warn",
    "format:check": "prettier --check . --log-level warn",
    "db:generate": "pnpm --filter @datascribe/db generate",
    "db:migrate": "pnpm --filter @datascribe/db migrate:dev",
    "db:seed": "pnpm --filter @datascribe/db seed",
    "db:seed:demo": "pnpm --filter @datascribe/db seed:demo",
    "staging:check": "node scripts/staging.mjs check",
    "staging:db:reset": "node scripts/staging.mjs db:reset",
    "staging:db:migrate": "node scripts/staging.mjs db:migrate",
    "staging:build": "node scripts/staging.mjs build",
    "staging:start": "node scripts/staging.mjs start",
    "staging:stop": "node scripts/staging.mjs stop",
    "staging:smoke": "node scripts/staging-smoke.mjs",
    "infra:up": "docker-compose up -d --wait",
    "infra:down": "docker-compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.25.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vitest": "^3.1.2"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "^3.4.17",
      "postcss": "^8.5.23",
      "sharp": "^0.35.5"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "sharp"
    ]
  }
}
